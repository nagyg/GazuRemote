# Normalize line endings to LF in the repository
* text=auto eol=lf

# Windows batch files need CRLF in the working tree: cmd.exe misparses LF-only files
# (labels / goto and lines split at block boundaries, e.g. "'M' is not recognized")
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files – no conversion
*.ico binary
*.png binary
*.jpg binary
*.svg binary
*.exe binary
